{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pallanguzhi-mp",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  // SQLite-backed Durable Objects are the ones the free plan includes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  "vars": {
    // Browser origins allowed to create rooms and open sockets. localhost is always allowed.
    "ALLOWED_ORIGINS": "https://www.pallanguzhi.com,https://pallanguzhi.com"
  },
  // Per-IP caps. Generous, because one mobile-carrier IP can be many real players.
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }, // new games
    { "name": "JOIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 90, "period": 60 } } // socket connects
  ],
  // Secret (not here): TURNSTILE_SECRET. Set with `wrangler secret put TURNSTILE_SECRET`.
  "observability": { "enabled": true }
}
